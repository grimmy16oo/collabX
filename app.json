{
  "expo": {
    "name": "collabx",
    "slug": "collabx",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "collabx",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.collabx.app",
      "icon": "./assets/images/logo.png"
    },
    "android": {
      "package": "com.collabx.app",
      "icon": "./assets/images/logo.png",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CollabX to let you choose a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#153018",
          "image": "./assets/images/logo.png",
          "imageWidth": 86
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
