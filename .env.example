# Optional: set this for a deployed backend. During Expo development, the API
# defaults to the current Expo host on port 4000, so no Wi-Fi-specific edit is needed.
# EXPO_PUBLIC_API_URL=https://your-api.example.com

# Firebase Authentication (from Firebase Console -> Project Settings -> General -> Web App)
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=collabx-8def0.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=collabx-8def0
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=collabx-8def0.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

